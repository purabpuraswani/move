# MoveWell AI backend configuration
#
# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.


# ---------------------------------------------------------------------------
# Database (required)
#
# This is the only value that changes between local MongoDB and MongoDB Atlas.
#
#   local  ->  mongodb://localhost:27017
#   atlas  ->  mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#
# URL-encode any special characters in an Atlas password.
# ---------------------------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017

MONGODB_DB_NAME=movewell


# ---------------------------------------------------------------------------
# Authentication (required)
#
# Generate a unique secret per environment. Never reuse the example value,
# never commit a real one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Minimum length is 32 characters. Changing it invalidates all issued tokens.
# ---------------------------------------------------------------------------

JWT_SECRET=replace-me-with-a-generated-secret-of-at-least-32-characters

JWT_ALGORITHM=HS256

JWT_EXPIRES_MINUTES=10080


# ---------------------------------------------------------------------------
# CORS (optional)
#
# Comma-separated list of allowed frontend origins.
# Defaults to the Vite dev server if unset. Set explicitly when deploying.
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------------------
# Medical report storage (optional)
#
# Uploaded reports are written through a storage interface. "local" keeps them
# on the machine running the API, which is fine for development. A deployment
# that needs files to survive a restart should add a durable backend rather
# than relying on a container filesystem.
#
# REPORT_STORAGE_DIR is relative to the backend/ directory unless absolute.
# ---------------------------------------------------------------------------

REPORT_STORAGE_BACKEND=local

REPORT_STORAGE_DIR=uploads/reports

REPORT_MAX_UPLOAD_MB=15


# ---------------------------------------------------------------------------
# AI provider (optional)
#
# Used to read candidate values off an uploaded report, and to generate wellness
# guidance and care navigation. Nothing here is required. With no key configured,
# the application says that automatic reading is unavailable and offers manual
# entry instead; it never invents values to fill the gap.
#
# The provider is OpenRouter, which puts an OpenAI-compatible chat-completions
# API in front of many models. Create a key at openrouter.ai/keys; it starts
# with sk-or-. The account needs credit for requests to succeed.
#
# This key is read by the backend only. It must never be copied into a Vite
# variable or otherwise reach the browser, and a real key must never be written
# into this example file.
#
# Set AI_PROVIDER=none to switch AI off even when a key is present.
# ---------------------------------------------------------------------------

AI_PROVIDER=auto

OPENROUTER_API_KEY=

# Pick any model that supports BOTH tool calling and image input. Both are
# needed: tool calling is how structured output is enforced, and image input is
# how a photographed report is read. Check a model's capabilities on
# openrouter.ai/models before switching. Reasonable choices:
#
#   google/gemini-2.5-flash      inexpensive and strong at reading documents
#   anthropic/claude-sonnet-4.5  more accurate, more expensive
#   openai/gpt-4o-mini           cheapest, weakest on faint or skewed print
#
# If a model name is wrong the API returns 404 and the app says so, naming this
# variable. It does not fall back to another model on its own.

OPENROUTER_MODEL=google/gemini-2.5-flash

AI_REQUEST_TIMEOUT_SECONDS=90

AI_MAX_OUTPUT_TOKENS=4096


# ---------------------------------------------------------------------------
# OpenRouter extras (all optional, none are secrets)
#
# The two attribution values label this app's traffic in the OpenRouter
# dashboard and affect nothing else. Both can be left as they are.
#
# OPENROUTER_BASE_URL only changes if requests are routed through your own
# gateway that speaks the same API. It must include the /api/v1 path.
#
# OPENROUTER_PDF_ENGINE forces how a PDF is turned into something the model can
# see: native, pdf-text or mistral-ocr. Leave it empty to let OpenRouter choose,
# which is the setting that keeps working if those engine names change.
# ---------------------------------------------------------------------------

OPENROUTER_SITE_URL=http://localhost:5173

OPENROUTER_APP_TITLE=MoveWell AI

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_PDF_ENGINE=


# ---------------------------------------------------------------------------
# Guidance agents (optional)
#
# The wellness guidance and care navigation agents use the same provider and the
# same key as report reading. They get their own model setting because
# transcribing a scanned document and writing a few paragraphs are different
# jobs at different prices, and a deployment may want a cheaper model for the
# second without changing the first.
#
# Leave AI_AGENT_MODEL unset to use OPENROUTER_MODEL above.
# ---------------------------------------------------------------------------

AI_AGENT_MODEL=

AI_AGENT_MAX_OUTPUT_TOKENS=3000


# ---------------------------------------------------------------------------
# Gemini (Google), a second AI provider (optional)
#
# Reached directly, not through OpenRouter. Useful when OpenRouter has no
# credit left: set GEMINI_API_KEY here and leave OPENROUTER_API_KEY blank
# (or just out of credit), and AI_PROVIDER=auto picks Gemini automatically.
# If both keys are set, OpenRouter is tried first.
#
# Create a key at aistudio.google.com/apikey; it starts with AIza. Gemini has
# a free tier (rate-limited, no card required) as well as paid billing.
#
# Pick a model that supports BOTH function calling and image input, same
# requirement as OPENROUTER_MODEL above. "gemini-flash-latest" is an alias
# Google keeps pointed at its current flash model, so it keeps working as
# dated snapshot names are retired (Google has been retiring those every
# few months -- if you see "is no longer available to new users" from this
# app, that is what happened; run check_gemini_models.py to see the current
# list and check_gemini_raw.py to see Google's exact error text). Check
# ai.google.dev/gemini-api/docs/models before pinning a dated name instead.
#
# GEMINI_AGENT_MODEL mirrors AI_AGENT_MODEL: leave it unset to reuse
# GEMINI_MODEL for the guidance agents too.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-latest

GEMINI_AGENT_MODEL=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

